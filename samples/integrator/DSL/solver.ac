run_const real AC_len_w = 1.0
run_const real AC_ds_w = AC_nlocal_w == 1 ? 1.0 : AC_len_w/(AC_nlocal_w-1)
run_const real AC_first_gridpoint_w = 0.0
bool AC_trapezoidal = false
bool AC_gauss_legendre = true


integrand_wrapper(real w)
{
	pos = grid_position()
	return integrand_wrapper(pos.x,pos.y,pos.z,w)
}

integrand_wrapper(real x_, real y_, real z_ , real w_)
{
	x = (AC_integration_points_x > 1 && AC_logspace_x) ? exp(x_) : x_
	y = (AC_integration_points_y > 1 && AC_logspace_y) ? exp(y_) : y_
	z = (AC_integration_points_z > 1 && AC_logspace_z) ? exp(z_) : z_
	w = (AC_integration_points_w > 1 && AC_logspace_w) ? exp(w_) : w_

	res = integrand(x,y,z,w)
	if(AC_integration_points_x > 1 && AC_logspace_x)
	{
		res *= x
	}
	if(AC_integration_points_y > 1 && AC_logspace_y)
	{
		res *= y
	}
	if(AC_integration_points_z > 1 && AC_logspace_y)
	{
		res *= z
	}
	if(AC_integration_points_w > 1 && AC_logspace_z)
	{
		res *= w
	}
        return res
}
bool AC_integrate_using_z = true
real AC_alp2 = 0.
real AC_inv_alp = 0.
real AA = 0.
int AC_model = 0
const int AC_MODEL_DBPL = 1

get_Eptilde(p,ptilde2)
{
	if(AC_model == AC_MODEL_DBPL)
	{
          return AA*pow(ptilde2,0.5*AC_a)/pow(AC_b + AC_a*pow(ptilde2, 0.5*AC_alp2),AC_inv_alp)
	}
	return  E_PTILDE[vertexIdx.x][vertexIdx.y]
}
get_Ep(p)
{
	if(AC_model == AC_MODEL_DBPL)
	{
          return AA*pow(p,AC_a)/pow(AC_b + AC_a*pow(p,AC_alp2),AC_inv_alp)
	}
	return E_P[vertexIdx.x]
}
const int AC_TYPE_VORTICAL = 0
const int AC_TYPE_COMP = 1
const int AC_TYPE_MIXED = 2
const int AC_TYPE_HEL = 3
const int AC_TYPE_VORT_ASYMM = 4
const int AC_TYPE_COMP_ASYMM = 5
const int AC_TYPE_VORT_PROD = 6
const int AC_TYPE_VORT_PROD_B = 7

tensor_struct(k,p,z,ptilde2)
{
	type = AC_type
        if(type==AC_TYPE_VORTICAL)
        {
          return 0.5*(1 + z*z)*(2.0-p*p*(1-z*z)/ptilde2)/(p*pow(ptilde2,1.5))
        }
        if(type==AC_TYPE_COMP)
        {
          return 2*pow(1 - z*z,2)/pow(ptilde2,2.5)*p
        }
        if(type==AC_TYPE_MIXED)
        {
          return 2*(1 - z*z*z*z)/pow(ptilde2,2.5)*p
        }
        if(type==AC_TYPE_HEL)
        {
          return 2*z*(k-p*z)/(ptilde2*ptilde2*p)
        }
        if(type==AC_TYPE_VORT_ASYMM)
        {
          return 2*z*(k-p*z)*(1+z*z)/(ptilde2*ptilde2*p)
        }
        if(type==AC_TYPE_COMP_ASYMM)
        {
          return 2*(k-p*z)*(1-z*z)/(ptilde2*ptilde2*p)
        }
        // vorticity prod term 1
        if(type==AC_TYPE_VORT_PROD)
        {
          return 0.5*k*k*p*(1-z*z)*(p*p-ptilde2)/pow(ptilde2,2.5)
        }
        // vorticity prod term 1 - option B
        if(type==AC_TYPE_VORT_PROD_B)
        {
          return 0.25*k*k/p*(1-z*z)*pow(p*p-ptilde2,2)/pow(ptilde2,2.5)
        }
	return 0.0
}

get_z(y,ptilde2,p,k)
{
	if(AC_integrate_using_z)
	{
		return y
	}
	z = (-ptilde2+p*p+k*k)/(2*p*k)
	return z
}

integrand(real x, real y, real z_, real w)
{
	real u
	real l
	k = AC_k
        // integrand for Kraichnan
	// v = AC_v
 	// t1 = x
 	// t2 = y
	// return exp(-(t1-t2)*(t1-t2)*v*v)*cos(k*(t1-t2))/(t1*t2)

        // integrand for EPi_vort
	p=x
	z=y
	real ptilde2
	real ptilde
	if(AC_integrate_using_z)
	{
        	ptilde2 = p*p + k*k - 2*p*k*z
	}
	else
	{
	  //Z range is [-1,1] that is mapped to [|k-p|,k+p]
	  l = abs(k-p)
	  u = k+p
	  ptilde = 0.5*(u-l)*z + 0.5*(u+l)
	  ptilde2 = ptilde*ptilde
	}	
	z = get_z(y,ptilde2,p,k)
        if(ptilde2 == 0)
        {
             ptilde2 = 1.e-20
        }
        if(p == 0)
        {
             p = 1.e-20
        }
        Eptilde = get_Eptilde(p,ptilde2)
	Ep = get_Ep(p)
        res = Ep*Eptilde*tensor_struct(k,p,z,ptilde2)
	//res = p*z
	if(!AC_integrate_using_z)
	{
          //dz=-ptilde/p*dptilde
          //and limits are swapped so multiply with ptilde/p
	  res *= ptilde/(p*k)
	  //Jacobian determinant from mapping [-1,1] to [|k-p|,k+p}
	  res *= 0.5*(u-l)
	}
	return res
}


