cmake_minimum_required(VERSION 3.15...3.28)

macro(_pyastaroth_find_python)
    # Taken from https://nanobind.readthedocs.io/en/latest/building.html
    if (CMAKE_VERSION VERSION_LESS 3.18)
        set(DEV_MODULE Development)
    else()
        set(DEV_MODULE Development.Module)
    endif()

    find_package(
        Python
        3.8
        COMPONENTS
            Interpreter ${DEV_MODULE}
        REQUIRED
    )
endmacro()


macro(_pyastaroth_find_nanobind)
    _pyastaroth_find_python()

    # Detect the installed nanobind package and import it into CMake
    execute_process(
        COMMAND
            "${Python_EXECUTABLE}" -m nanobind --cmake_dir
        OUTPUT_STRIP_TRAILING_WHITESPACE
        OUTPUT_VARIABLE
            nanobind_ROOT
    )
    find_package(nanobind CONFIG REQUIRED)

    if (NOT CMAKE_BUILD_TYPE AND NOT CMAKE_CONFIGURATION_TYPES)
        set(CMAKE_BUILD_TYPE Release CACHE STRING "Choose the type of build." FORCE)
        set_property(CACHE CMAKE_BUILD_TYPE PROPERTY STRINGS "Debug" "Release" "MinSizeRel" "RelWithDebInfo")
    endif()
endmacro()


macro(_pyastaroth_find_mpi4py)
    _pyastaroth_find_python()

    # Detect if mpi4py is installed and get from it the include directory needed to compile the
    # Python bindings.
    execute_process(
        COMMAND
            "${Python_EXECUTABLE}" -c "import mpi4py as m; print(m.get_include());"
        OUTPUT_STRIP_TRAILING_WHITESPACE
        OUTPUT_VARIABLE
            mpi4py_INCLUDE_DIR
    )
endmacro()

function(_pyastaroth_generate_bindings
         target
         parent_module
)
    _pyastaroth_find_nanobind()
    _pyastaroth_find_mpi4py()

    set(parent_module "${parent_module}/astaroth")

    set(base_pydef_dir "${CMAKE_SOURCE_DIR}/python/pydef")
    set(base_stubs_dir "${CMAKE_SOURCE_DIR}/python/stubs/")
    set(bindings_include_directories
        "${CMAKE_SOURCE_DIR}/include"
        "${CMAKE_SOURCE_DIR}/stdlib"
        "${CMAKE_BINARY_DIR}/acc-runtime/api"
        "${CMAKE_SOURCE_DIR}/acc-runtime/api"
    )

    set(astaroth_core_input_pydef "${base_pydef_dir}/core.cc")

    litgen_generate_bindings(
        astaroth_core_bindings
        "${astaroth_core_input_pydef}"
        "${base_stubs_dir}/core.pyi"
        "${CMAKE_SOURCE_DIR}/include/astaroth.h"
        "${CMAKE_CURRENT_BINARY_DIR}"
        BASE_DIR
            "${CMAKE_SOURCE_DIR}"
        INCLUDE_DIRECTORIES
            "${bindings_include_directories}"
        DEPENDENCIES
            acc-runtime-headers
            astaroth_core
        AMALGAMATE
    )

    nanobind_add_module(
        core
        NB_SUPPRESS_WARNINGS
        ${astaroth_core_bindings_pydef}
    )
    target_link_libraries(core PRIVATE astaroth_core)
    ac_link_mpi(core)
    target_include_directories(
        core
        PRIVATE
            ${bindings_include_directories}
            ${mpi4py_INCLUDE_DIR}
    )
    install(
        TARGETS
            core
        LIBRARY
        DESTINATION
            ${parent_module}
    )

    set(astaroth_utils_input_pydef "${base_pydef_dir}/utils.cc")

    litgen_generate_bindings(
        astaroth_utils_bindings
        "${astaroth_utils_input_pydef}"
        "${base_stubs_dir}/utils.pyi"
        "${CMAKE_SOURCE_DIR}/include/astaroth_utils.h"
        "${CMAKE_CURRENT_BINARY_DIR}"
        BASE_DIR
            "${CMAKE_SOURCE_DIR}"
        INCLUDE_DIRECTORIES
            "${bindings_include_directories}"
        DEPENDENCIES
            acc-runtime-headers
            astaroth_utils
    )

    nanobind_add_module(
        utils
        NB_SUPPRESS_WARNINGS
        ${astaroth_utils_bindings_pydef}
    )
    target_link_libraries(utils PRIVATE astaroth_utils)
    ac_link_mpi(utils)
    target_include_directories(
        utils
        PRIVATE
            ${bindings_include_directories}
            ${mpi4py_INCLUDE_DIR}
    )
    install(
        TARGETS
            utils
        LIBRARY
        DESTINATION
            ${parent_module}
    )

    # Sources generated by litgen produce a _lot of_ warnings.
    set_source_files_properties(
        ${astaroth_bindings_pydef}
        ${astaroth_utils_bindings_pydef}
        PROPERTIES
        COMPILE_FLAGS "-w"
    )

    install(
        FILES
            ${astaroth_utils_bindings_stubs}
            ${astaroth_core_bindings_stubs}
        DESTINATION
            ${parent_module}
    )
endfunction()

function(pyastaroth_add_application target)
    set(options "")
    set(oneValueArgs MODULE_NAME)
    set(multiValueArgs SOURCES)
    cmake_parse_arguments(PARSE_ARGV 1 arg
        "${options}" "${oneValueArgs}" "${multiValueArgs}"
    )

    if (DEFINED arg_MODULE_NAME)
        set(module_name $arg_MODULE_NAME})
    else()
        set(module_name ${target})
    endif()

    set(bindings_target "${target}_python_bindings")
    _pyastaroth_generate_bindings(${bindings_target} ${module_name})
endfunction()
