@PACKAGE_INIT@
find_package(OpenMP)
if(@MPI_ENABLED@)
  set(MPI_CXX_SKIP_MPICXX ON) # Skip MPI C++ bindings
  add_compile_definitions(OMPI_SKIP_MPICXX)
  find_package(MPI REQUIRED COMPONENTS C)
  add_definitions(-DAC_MPI_ENABLED=1)
else()
  add_definitions(-DAC_MPI_ENABLED=0)
endif()
if(@CPU_BUILD@)
    add_definitions(-DAC_CPU_BUILD=1)
else()
    add_definitions(-DAC_CPU_BUILD=0)
endif()
if (@DOUBLE_PRECISION@)
    add_definitions(-DAC_DOUBLE_PRECISION=1)
else()
    add_definitions(-DAC_DOUBLE_PRECISION=0)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/AstarothTargets.cmake")
